{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/session_start.py\"", "timeout": 10}]}],
    "PreToolUse": [{"matcher": "Bash|exec_command|run_command", "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/dangerous_command_guard.py\"", "timeout": 5}]}],
    "PostToolUse": [{"matcher": "apply_patch|Write|Edit|write_file|edit_file", "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/project_check.py\"", "timeout": 5}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/stop_guard.py\"", "timeout": 10}]}]
  }
}
